{
  "name": "autodl-companion",
  "version": "1.0.0",
  "private": true,
  "description": "AutoDL 实例与 GPU 库存助手",
  "author": "Local project",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test src/queue-state.test.js src/core.test.js src/stock-client.test.js src/main.test.js src/session.test.js src/rent-workspace.test.js vendor/autodl-watch/tests/*.test.mjs",
    "dist": "electron-builder --win",
    "dist:installer": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "local.autodl.companion",
    "productName": "autoautodl",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "vendor/autodl-watch/src/**/*",
      "vendor/autodl-watch/public/**/*",
      "vendor/autodl-watch/LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signExecutable": false,
      "icon": "src/assets/autoautodl.ico"
    },
    "portable": {
      "artifactName": "autoautodl-${version}-Windows.exe",
      "unpackDirName": true
    },
    "asarUnpack": [
      "node_modules/playwright*/**/*"
    ],
    "nsis": {
      "artifactName": "autoautodl-${version}-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "autoautodl",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "src/assets/autoautodl.ico",
      "uninstallerIcon": "src/assets/autoautodl.ico",
      "runAfterFinish": true
    }
  },
  "dependencies": {
    "playwright": "1.56.1"
  }
}
